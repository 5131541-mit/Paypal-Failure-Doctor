# PayPal is pinned to Sandbox unless explicitly changed by the API server.
PAYPAL_ENVIRONMENT=sandbox

# Existing unprefixed credentials are Sandbox-only for backward compatibility.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

# Sandbox webhook ID.
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=

# Live payments are disabled by default.
PAYPAL_LIVE_PAYMENTS_ENABLED=false
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_AMOUNT=
PAYPAL_LIVE_CURRENCY=USD
PAYPAL_LIVE_DESCRIPTION=

# Optional: OpenRouter-powered incident diagnosis.
# Keep the API key on the server. Never expose it in frontend code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# API server port.
PORT=8787

# PostgreSQL configuration.
# Leave DATABASE_URL empty if PostgreSQL is not being used.
DATABASE_URL=
PG_POOL_MAX=10

# Set to require only when your remote PostgreSQL provider requires TLS.
PGSSLMODE=

# Local authentication.
# This default is intended for local development.
# Review authentication and database settings before production deployment.
LOCAL_AUTH_ENABLED=true

# MFA encryption key.
# Generate a key using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the same key securely backed up in your API host's secret manager.
# Never commit the actual key.
MFA_ENCRYPTION_KEY=

# Allowed browser origins.
# Set this to the exact frontend origin(s) permitted by the API server.
ALLOWED_ORIGINS=http://localhost:5173

# Optional frontend API base URL.
VITE_API_BASE_URL=

# Required for the local Docker Compose PostgreSQL setup.
# Use the same password in DATABASE_URL in your private .env file.
# Never commit your private .env file.
POSTGRES_PASSWORD=
