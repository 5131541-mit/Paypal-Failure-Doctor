
# PayPal is pinned to Sandbox unless explicitly changed by the API server.
PAYPAL_ENVIRONMENT=sandbox

# Existing unprefixed credentials are Sandbox-only for backward compatibility.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

# Sandbox webhook ID. Add the webhook in the Sandbox app first.
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=

# Live payments are disabled by default.
PAYPAL_LIVE_PAYMENTS_ENABLED=false
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_AMOUNT=
PAYPAL_LIVE_CURRENCY=USD
PAYPAL_LIVE_DESCRIPTION=

# Optional: OpenRouter-powered incident diagnosis.
# Keep the API key server-side. Without it, the app uses its local recovery advisor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

PORT=8787

# Optional for local MVP mode. Local accounts are saved on this app server.
# Set DATABASE_URL when PostgreSQL is running or use the included Compose stack.
DATABASE_URL=
PG_POOL_MAX=10

# Set PGSSLMODE=require only for remote providers that require TLS.
PGSSLMODE=

# Local file authentication is enabled by default in development.
# Set false to run a disposable, unauthenticated local demo.
# Production requires PostgreSQL.
LOCAL_AUTH_ENABLED=true

# Required to enroll authenticator-based two-step verification.
# Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable and backed up in the API host's secret manager.
# Do not commit the actual key.
MFA_ENCRYPTION_KEY=

# Comma-separated exact browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=
